/**
  * @brief  The application entry point.
  */

int main(void)
{
    /* Reset peripherals */

    HAL_Init();


    /* Configure clock */

    SystemClock_Config();


    /* Initialize peripherals */

    MX_GPIO_Init();

    MX_DMA_Init();

    MX_USART1_UART_Init();


    /* USER CODE BEGIN 2 */

    char start_message[] =
        "IoT Environmental Monitoring System\r\n";


    /* Send startup message using DMA */

    dma_tx_complete = 0;

    HAL_UART_Transmit_DMA(&huart1,
                          (uint8_t *)start_message,
                          strlen(start_message));


    HAL_Delay(1000);


    /* USER CODE END 2 */


    /* Infinite loop */

    while (1)
    {
        /* -------------------------------------------------
           READ DHT11
           ------------------------------------------------- */

        if (DHT11_Read(&temperature,
                       &humidity))
        {
            /* Create message */

            int length = sprintf(
                (char *)txData,
                "Temperature: %d C\r\nHumidity: %d %%\r\n",
                temperature,
                humidity
            );


            /* Wait for previous DMA transfer */

            while (dma_tx_complete == 0)
            {
            }


            /* Start new DMA transmission */

            dma_tx_complete = 0;

            HAL_UART_Transmit_DMA(
                &huart1,
                txData,
                length
            );
        }
        else
        {
            char error_message[] =
                "DHT11 Error\r\n";


            /* Wait for previous DMA transfer */

            while (dma_tx_complete == 0)
            {
            }


            dma_tx_complete = 0;


            /* Send error using DMA */

            HAL_UART_Transmit_DMA(
                &huart1,
                (uint8_t *)error_message,
                strlen(error_message)
            );
        }


        /* DHT11 minimum interval */

        HAL_Delay(2000);
    }
}


