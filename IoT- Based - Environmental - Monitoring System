/* =========================================================
   DHT11 READ
   ========================================================= */

uint8_t DHT11_Read(uint8_t *temperature,
                   uint8_t *humidity)
{
    uint8_t data[5] = {0};

    uint32_t timeout;
    uint32_t i;
    uint32_t j;


    /* -----------------------------------------------------
       START SIGNAL
       ----------------------------------------------------- */

    DHT11_Output();

    HAL_GPIO_WritePin(DHT11_PORT,
                      DHT11_PIN,
                      GPIO_PIN_RESET);

    HAL_Delay(20);

    HAL_GPIO_WritePin(DHT11_PORT,
                      DHT11_PIN,
                      GPIO_PIN_SET);

    delay_us(30);

    DHT11_Input();


    /* -----------------------------------------------------
       DHT11 RESPONSE
       ----------------------------------------------------- */

    timeout = 1000;

    while (HAL_GPIO_ReadPin(DHT11_PORT,
                            DHT11_PIN) == GPIO_PIN_SET)
    {
        if (timeout-- == 0)
            return 0;

        delay_us(1);
    }


    timeout = 1000;

    while (HAL_GPIO_ReadPin(DHT11_PORT,
                            DHT11_PIN) == GPIO_PIN_RESET)
    {
        if (timeout-- == 0)
            return 0;

        delay_us(1);
    }


    timeout = 1000;

    while (HAL_GPIO_ReadPin(DHT11_PORT,
                            DHT11_PIN) == GPIO_PIN_SET)
    {
        if (timeout-- == 0)
            return 0;

        delay_us(1);
    }


    /* -----------------------------------------------------
       READ 40 BITS
       ----------------------------------------------------- */

    for (i = 0; i < 5; i++)
    {
        for (j = 0; j < 8; j++)
        {
            /* Wait for LOW to finish */

            timeout = 1000;

            while (HAL_GPIO_ReadPin(DHT11_PORT,
                                    DHT11_PIN) == GPIO_PIN_RESET)
            {
                if (timeout-- == 0)
                    return 0;

                delay_us(1);
            }


            /* Wait approximately 40 us */

            delay_us(40);


            /*
             * If pin is still HIGH after 40 us,
             * bit = 1
             *
             * Otherwise bit = 0
             */

            if (HAL_GPIO_ReadPin(DHT11_PORT,
                                 DHT11_PIN) == GPIO_PIN_SET)
            {
                data[i] |= (1 << (7 - j));
            }


            /* Wait until HIGH becomes LOW */

            timeout = 1000;

            while (HAL_GPIO_ReadPin(DHT11_PORT,
                                    DHT11_PIN) == GPIO_PIN_SET)
            {
                if (timeout-- == 0)
                    return 0;

                delay_us(1);
            }
        }
    }


    /* -----------------------------------------------------
       CHECKSUM
       ----------------------------------------------------- */

    if ((uint8_t)(data[0] +
                  data[1] +
                  data[2] +
                  data[3]) != data[4])
    {
        return 0;
    }


    /* -----------------------------------------------------
       GET VALUES
       ----------------------------------------------------- */

    *humidity = data[0];

    *temperature = data[2];


    return 1;
}


/* =========================================================
   DMA TRANSMISSION COMPLETE
   ========================================================= */

void HAL_UART_TxCpltCallback(UART_HandleTypeDef *huart)
{
    if (huart->Instance == USART1)
    {
        dma_tx_complete = 1;
    }
}


